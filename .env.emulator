# Used by `npm run dev:emulator`. Overrides .env so the app talks to the local Firebase
# Emulator Suite (`npm run emulators`). The demo- project ID tells Firebase this project
# exists only locally, so nothing here can reach a real project.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-svconnect.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-svconnect
VITE_FIREBASE_STORAGE_BUCKET=demo-svconnect.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_USE_EMULATORS=true
VITE_USE_CLOUD_FUNCTIONS=true
