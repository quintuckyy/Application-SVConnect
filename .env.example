# Copy this file to .env and fill in your own values. .env is gitignored.

# Firebase web app config (Project settings → General → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase (home screen announcements)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-side logic. Leave false unless the Cloud Functions in functions/ are deployed to
# this project (needs the Blaze plan). For local development use `npm run dev:emulator`.
VITE_USE_CLOUD_FUNCTIONS=false
VITE_USE_EMULATORS=false
